            <gradient
                android:centerX="144"
                android:centerY="144"
                android:gradientRadius="100"
                android:type="radial">
                <item android:color="#667C3AED" android:offset="0" />
                <item android:color="#2E7C3AED" android:offset="0.55" />
                <item android:color="#007C3AED" android:offset="1" />
