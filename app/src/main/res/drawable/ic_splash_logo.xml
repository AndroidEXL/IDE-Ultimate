    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- Ambient glow -->
    <path android:pathData="M44,144 a100,100 0 1,0 200,0 a100,100 0 1,0 -200,0 Z">
