<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <!-- Ambient glow -->
    <path android:pathData="M44,144 a100,100 0 1,0 200,0 a100,100 0 1,0 -200,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="144"
                android:centerY="144"
                android:gradientRadius="100"
                android:type="radial">
                <item android:color="#667C3AED" android:offset="0" />
                <item android:color="#2E7C3AED" android:offset="0.55" />
                <item android:color="#007C3AED" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Rotating orbit (animated by ic_splash_logo_animated.xml) -->
    <group
        android:name="ring_rotation"
        android:pivotX="144"
        android:pivotY="144">
        <path
            android:pathData="M144,56 A88,88 0 0 1 232,144"
            android:strokeWidth="2.4"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="144"
                    android:startY="56"
                    android:endX="232"
                    android:endY="144"
                    android:type="linear">
                    <item android:color="#0067E8F9" android:offset="0" />
                    <item android:color="#CC67E8F9" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M144,232 A88,88 0 0 1 56,144"
            android:strokeWidth="2.4"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="144"
                    android:startY="232"
                    android:endX="56"
                    android:endY="144"
                    android:type="linear">
                    <item android:color="#00F0ABFC" android:offset="0" />
                    <item android:color="#CCF0ABFC" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Hexagon frame -->
    <path
        android:pathData="M144,82 L197.69,113 L197.69,175 L144,206 L90.31,175 L90.31,113 Z"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="82"
                android:startY="82"
                android:endX="206"
                android:endY="206"
                android:type="linear">
                <item android:color="#2267E8F9" android:offset="0" />
                <item android:color="#FF67E8F9" android:offset="0.18" />
                <item android:color="#FFA78BFA" android:offset="0.6" />
                <item android:color="#FFF0ABFC" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Code brackets -->
    <path
        android:pathData="M120,124 L100,144 L120,164"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#FF67E8F9" />
    <path
        android:pathData="M168,124 L188,144 L168,164"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#FFC4B5FD" />
    <path
        android:pathData="M160,120 L128,168"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeColor="#E6FFFFFF" />
</vector>
